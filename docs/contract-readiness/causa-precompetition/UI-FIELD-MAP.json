    "exp002": "EXP-INDY-002 (PR #140, open, experimental): typed read-back events and nested picker labels; findings only, no code imported"
  },
  "conventions": {
    "accessibleName": "The catalog name (FieldSpec.Label: 'the accessible name the governed journeys look the field up by'). The element carries data-requirement-id=\"INV-0nn\".",
    "pickerLabels": "INV-031 is a Forma radio group whose group name is 'Evidence relationship kind' and whose option labels are exactly the catalog option texts supports, contradicts, consistent-with, inconclusive; no option is selected initially (OD-INDY-23). The evidence and hypothesis pickers of INV-030 are labelled 'Evidence' and 'Hypothesis' and list items by their visible label/statement, never by id.",
    "readBack": "After a save the UI re-reads the projection (Understood, 07-IF41-VIEW) and shows the stored value; a value is 'covered' only when its read-back field is the field the command wrote.",
    "lengths": "UTF-16 length after no trimming (CF-12 A); non-blank per CONTRACT §2.6."
  },
  "screens": [
    {"screenId": "investigation-list", "route": "#/", "states": ["disconnected", "connecting", "connected-loading", "connected-listed", "connected-empty", "unauthorized", "credential-refused", "network-failure", "rate-limited", "connection-validation-errors"], "mobile": ["390 px phone: no horizontal overflow (J3-09)", "820/1180 px iPad portrait/landscape", "1440 px desktop", "200% text reflow (UI-011)"]},
    {"screenId": "investigation-start", "route": "#/investigations/new", "states": ["editing", "validation-errors", "submitting", "refused", "accepted (navigates to the workspace)", "destination-unknown (not connected)"], "mobile": ["390 px phone: no horizontal overflow (J3-09)", "820/1180 px iPad portrait/landscape", "1440 px desktop", "200% text reflow (UI-011)"]},
