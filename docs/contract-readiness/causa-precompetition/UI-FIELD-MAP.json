    "catalog": "requirements/catalogs/causa-investigation.requirement-catalog.json",
    "screenManifest": "proposals/r10-contract-first-ui/SCREEN-MANIFEST.json (states, Forma patterns, responsive and accessibility obligations, per-requirement verification ids)",
