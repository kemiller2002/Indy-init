  "saveDurability": [
    {"stateId": "PS-LOCAL", "name": "Local changes", "saveStates": ["Unsaved"], "durable": false, "mayDisplaySaved": false, "evidence": "Edits applied to the session; nothing sent."},
    {"stateId": "PS-PENDING", "name": "Save pending", "saveStates": ["Saving"], "durable": false, "mayDisplaySaved": false, "evidence": "Mutation prepared or sent (MutationSent); no provider answer yet."},
    {"stateId": "PS-ACK", "name": "Provider write acknowledged", "saveStates": ["Saving"], "durable": false, "mayDisplaySaved": false, "evidence": "The provider answered the write; the read-back at the new commit is still outstanding. An acknowledgement is not durability (PERSIST-023)."},
    {"stateId": "PS-VERIFIED", "name": "Provider read-back verified", "saveStates": ["Saved"], "durable": true, "mayDisplaySaved": true, "evidence": "SavedBasis.Confirmed: Confirmation.ofReadBack requires the bytes re-read at the commit to equal the bytes written; or SavedBasis.VerifiedAt: the files were read from the provider and verified. Real-provider durability is established only against GitHub (live preflight J3-05); a provider double proves protocol behaviour only."},
    {"stateId": "PS-CONFLICT", "name": "Save conflict", "saveStates": ["Conflict"], "durable": false, "mayDisplaySaved": false, "evidence": "Stale head for the same investigation; SM-CONFLICT runs."},
    {"stateId": "PS-FAILED", "name": "Save failed", "saveStates": ["SaveFailed"], "durable": false, "mayDisplaySaved": false, "evidence": "SaveFailure: Refused, RepositoryKeptChanging, BytesDiffer, HistoryWasRewritten, CredentialNotAccepted."},
    {"stateId": "PS-OFFLINE", "name": "Offline / unverified", "saveStates": ["Offline", "UnknownOutcome"], "durable": false, "mayDisplaySaved": false, "evidence": "Offline: no write attempted. UnknownOutcome: the answer was lost; reconciliation reads the WriteMarker before any retry."}
