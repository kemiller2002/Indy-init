  "rules": {
    "replace": [
      "ui and ui-2 never own the same file; Shell.fs is ui's and ui-2 consumes it read-only."
    ],
    "with": [
      "No two UI roles (ui, ui-2, ui-3) own the same file; Views/Shell.fs is ui's and the other roles consume it read-only.",
      "No UI-owned file compiles before src/Causa.App/Projections.fs, which holds IF41-VIEW (frozen view types and Causa.Ui.Contracts) and is integration-owned.",
      "Screens emit UiIntent and read AppView only; no UI role edits Engine.fs, Update.fs, Projections.fs or View.fs.",
      "A UI role changes web/index.html only through its own web/screens/<screen>.html and .css fragments (CF-08 A)."
    ],
    "note": "the integration-only path rule (checks X02, X18) gains web/screens/ includes in build.fsx; it keeps web/index.html and web/causa.css integration-owned",
    "integrationOnlyPathRule": {
      "keep": "Integration alone writes: ... web/index.html, web/causa.css ... (unchanged)",
      "replaceSentence": "A UI role changes web/index.html or web/causa.css only through a change request integration owns and applies (v4.1.1).",
      "with": "A UI role changes web/index.html or web/causa.css only through a change request integration owns and applies (v4.1.1); each UI role writes only its own screen fragments web/screens/<screen>.html and web/screens/<screen>.css as proposals/r10-contract-first-ui/COMPETITION-UI-OWNERSHIP.json assigns them, and web/index.html includes them through build.fsx, which integration writes at bootstrap with every fragment listed.",
      "why": "the fragments are not compiled and are created during the run, so they are owned by this rule, not bootstrapped (no uiFiles key exists in project-structure)"
    }
  },
