{
  "schema": "indy-init.r10-contract-first-ui.file-ownership/1",
  "status": "PROPOSAL. Valid only through a successor package (v4.1.5) that adopts it; under v4.1.4 the frozen ownership (requirements-compiled/v4.1.4/analysis/project-structure.json) stands.",
  "roles": {
    "ui-a": "connection and browsing: shell, connection, investigation list, workspace frame, stored record and timeline, loading/empty/error states, administration, settings",
    "ui-b": "investigation editing: start, details editor, validation presentation, save indicator, conflict review, history",
    "ui-c": "investigation analysis: overview content, hypotheses, evidence, relationships, conclusions, inspector, causal graph, report",
    "integration": "shell composition, routing, Engine/Update, the UI adapter, View.fs/Program.fs, every project and shared file",
    "coordinator": "UI contract change control (versioned, consumers notified before merge)",
    "domain": "unchanged (src/Causa.Domain/*)",
    "persistence": "unchanged (src/Causa.Persistence/*, tests/Causa.TestSupport/Recordings.fs, StatefulFake.fs)"
  },
  "twoAgentVariant": "ui-a keeps its files; ui-b takes ui-c's files except Inspector.fs, Graph.fs, Report.fs (and their fragments and tests), which go to ui-a (schedule-inputs/roles.contract-first-2ui.json)",
  "compileOrder": [
    "Engine.fs",
    "Routes.fs",
    "Projections.fs (types)",
    "Ui/Contracts/*",
    "Connection.fs",
    "Ui/UiAdapter.fs",
    "Ui/Events.fs",
    "Reporting.fs",
    "Update.fs",
    "Views/*",
    "View.fs",
    "Program.fs"
  ],
  "rules": [
    "A file has exactly one owner; no two roles share a file.",
    "No UI-owned file compiles before the UI contracts: everything they depend on (Engine.fs, Routes.fs, Projections.fs types) is integration-owned and frozen at bootstrap (verified: evidence/bootstrap-compile.log).",
    "Screens emit UiIntent and read AppView only; no screen file edits Update.fs, Engine.fs, Projections.fs or View.fs.",
    "UI contract files change only by a versioned change request through the coordinator, written by integration.",
    "Markup lives in web/screens/<screen>.html, one file per screen; web/index.html only includes them (needs CF-08).",
    "Unchanged from v4.1.4: integration alone writes project, solution, package and CI files; domain and persistence ownership is unchanged."
  ],
