// Generates fixtures/CausaDataExtract.g.fs from a checkout of kemiller2002/causa-data. Every value is copied verbatim
// from the stored files; nothing is summarised, paraphrased or invented (mission: no fabricated historical facts).
// The generated values are fixtures: they prove nothing about the real GitHub provider or about Causa's own replay.
//
//   dotnet fsi tools/extract-fixtures.fsx -- <causa-data checkout> <commit sha> fixtures/CausaDataExtract.g.fs
open System
open System.IO
open System.Text.Json

let args = fsi.CommandLineArgs |> Array.skip 1 |> Array.skipWhile ((=) "--")
let root, commit, out = args.[0], args.[1], args.[2]

let read (p: string) = JsonDocument.Parse(File.ReadAllText(Path.Combine(root, p))).RootElement
let str (e: JsonElement) (k: string) =
    match e.TryGetProperty k with
    | true, v when v.ValueKind = JsonValueKind.String -> Some(v.GetString() |> string)
    | _ -> None
let arr (e: JsonElement) (k: string) = e.GetProperty(k).EnumerateArray() |> List.ofSeq
let lit (s: string) =
    "\"" + s.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r", "\\r").Replace("\n", "\\n").Replace("\t", "\\t") + "\""
let optLit (s: string option) = match s with Some v -> sprintf "Some %s" (lit v) | None -> "None"

let active = read "catalog/active.json"
let manifestPath = str active "manifest" |> Option.get
let catalog = read manifestPath

let cases =
    arr catalog "cases"
    |> List.map (fun c ->
        let path = str c "path" |> Option.get
        let m = read (path + "/manifest.json")
        let state = (read (path + "/snapshot.json")).GetProperty "state"
        {| Key = str c "caseKey" |> Option.get
           Id = str c "investigationId" |> Option.get
           Title = str c "title" |> Option.get
           Path = path
           CreatedAt = str m "createdAt" |> Option.get
           UpdatedAt = str m "updatedAt" |> Option.get
           EventCount = m.GetProperty("eventCount").GetInt32()
           Lifecycle = str state "lifecycle" |> Option.get
           Hypotheses = (arr state "hypotheses").Length
           Evidence = (arr state "evidence").Length
           Contradictions = (arr state "contradictions").Length |})

let apollo11 = cases |> List.find (fun c -> c.Key = "apollo-11")
let events =
    File.ReadLines(Path.Combine(root, apollo11.Path, "events.ndjson"))
    |> Seq.truncate 6
    |> Seq.map (fun l ->
        let e = JsonDocument.Parse(l).RootElement
        {| Version = e.GetProperty("aggregateVersion").GetInt64()
           Type = str e "eventType" |> Option.get
           At = str e "occurredAt" |> Option.get
           Actor = e.GetProperty("actor").GetProperty("actorId").GetString() |> string
           Payload = e.GetProperty("payload").GetRawText() |})
    |> List.ofSeq

// A small, connected slice of the stored snapshot: the first supported hypothesis, up to three of its relationships,
// their evidence, the first three observations and the conclusion. Copied, not interpreted.
let state = (read (apollo11.Path + "/snapshot.json")).GetProperty "state"
let hypothesis = arr state "hypotheses" |> List.find (fun h -> str h "state" = Some "supported")
let hid = str hypothesis "id" |> Option.get
let rels = arr state "relationships" |> List.filter (fun r -> str r "hypothesisId" = Some hid) |> List.truncate 3
let evIds = rels |> List.choose (fun r -> str r "evidenceId") |> set
let evidence = arr state "evidence" |> List.filter (fun e -> evIds.Contains(str e "id" |> Option.get))
let observations = arr state "observations" |> List.truncate 3
let conclusion = arr state "conclusions" |> List.head

let lines =
    [ yield "// <auto-generated> by tools/extract-fixtures.fsx from kemiller2002/causa-data at " + commit + ". Do not edit."
      yield "// FIXTURE DATA: copied verbatim from the stored files. It proves nothing about the real GitHub provider and is not"
      yield "// Causa's replay: lifecycle and snapshot content come from the stored reference-engine snapshot (snapshot.json)."
      yield "module Causa.Ui.Fixtures.CausaDataExtract"
      yield ""
      yield sprintf "let sourceRepository = %s" (lit "kemiller2002/causa-data")
      yield sprintf "let sourceCommit = %s" (lit commit)
      yield sprintf "let catalogManifest = %s" (lit manifestPath)
      yield ""
      yield "type StoredCase = { Key: string; Id: string; Title: string; Path: string; CreatedAt: string; UpdatedAt: string; EventCount: int; SnapshotLifecycle: string; SnapshotHypotheses: int; SnapshotEvidence: int; SnapshotContradictions: int }"
      yield ""
      yield "let cases : StoredCase list ="
      yield "    ["
      for c in cases do
          yield sprintf "      { Key = %s; Id = %s; Title = %s; Path = %s; CreatedAt = %s; UpdatedAt = %s; EventCount = %d; SnapshotLifecycle = %s; SnapshotHypotheses = %d; SnapshotEvidence = %d; SnapshotContradictions = %d }"
                        (lit c.Key) (lit c.Id) (lit c.Title) (lit c.Path) (lit c.CreatedAt) (lit c.UpdatedAt) c.EventCount (lit c.Lifecycle) c.Hypotheses c.Evidence c.Contradictions
      yield "    ]"
      yield ""
      yield "type StoredEventRow = { Version: int64; EventType: string; OccurredAt: string; ActorId: string; PayloadJson: string }"
      yield ""
      yield sprintf "/// The first %d stored events of %s, verbatim." events.Length apollo11.Key
      yield "let apollo11Events : StoredEventRow list ="
      yield "    ["
      for e in events do
          yield sprintf "      { Version = %dL; EventType = %s; OccurredAt = %s; ActorId = %s; PayloadJson = %s }" e.Version (lit e.Type) (lit e.At) (lit e.Actor) (lit e.Payload)
      yield "    ]"
      yield ""
      yield "type SnapshotHypothesis = { Id: string; Statement: string; State: string; Mechanism: string option }"
      yield "type SnapshotEvidence = { Id: string; Content: string; Category: string option; Source: string option; CapturedAt: string option }"
      yield "type SnapshotRelationship = { Id: string; EvidenceId: string; HypothesisId: string; Kind: string; Rationale: string }"
      yield "type SnapshotObservation = { Id: string; Original: string; ObservedAt: string option }"
      yield "type SnapshotConclusion = { Id: string; Statement: string; ResidualUncertainty: string option; RecordedAtVersion: int64 }"
      yield ""
      yield sprintf "let apollo11Hypothesis = { Id = %s; Statement = %s; State = %s; Mechanism = %s }"
                    (lit hid) (lit (str hypothesis "statement" |> Option.get)) (lit (str hypothesis "state" |> Option.get)) (optLit (str hypothesis "mechanism"))
      yield "let apollo11Evidence : SnapshotEvidence list ="
      yield "    ["
      for e in evidence do
          let src = match e.TryGetProperty "source" with | true, v when v.ValueKind = JsonValueKind.Object -> str v "reference" |> Option.orElse (Some(v.GetRawText())) | true, v when v.ValueKind = JsonValueKind.String -> Some(v.GetString() |> string) | _ -> None
          yield sprintf "      { Id = %s; Content = %s; Category = %s; Source = %s; CapturedAt = %s }"
                        (lit (str e "id" |> Option.get)) (lit (str e "content" |> Option.get)) (optLit (str e "category")) (optLit src) (optLit (str e "capturedAt"))
      yield "    ]"
      yield "let apollo11Relationships : SnapshotRelationship list ="
      yield "    ["
      for r in rels do
          yield sprintf "      { Id = %s; EvidenceId = %s; HypothesisId = %s; Kind = %s; Rationale = %s }"
                        (lit (str r "id" |> Option.get)) (lit (str r "evidenceId" |> Option.get)) (lit hid) (lit (str r "kind" |> Option.get)) (lit (str r "rationale" |> Option.defaultValue ""))
      yield "    ]"
      yield "let apollo11Observations : SnapshotObservation list ="
      yield "    ["
      for o in observations do
          yield sprintf "      { Id = %s; Original = %s; ObservedAt = %s }" (lit (str o "id" |> Option.get)) (lit (str o "original" |> Option.get)) (optLit (str o "observedAt"))
      yield "    ]"
      yield sprintf "let apollo11Conclusion = { Id = %s; Statement = %s; ResidualUncertainty = %s; RecordedAtVersion = %dL }"
                    (lit (str conclusion "id" |> Option.get)) (lit (str conclusion "statement" |> Option.get)) (optLit (str conclusion "residualUncertainty")) (conclusion.GetProperty("recordedAtVersion").GetInt64()) ]

File.WriteAllLines(out, lines)
printfn "extract-fixtures: %d cases, %d events, %d evidence, %d relationships -> %s" cases.Length events.Length evidence.Length rels.Length out
