    {
      "id": "APR-V4-OWNER-1",
      "authority": {
        "kind": "operator",
        "id": "kemiller2002"
      },
      "date": "2026-10-30",
      "changes": [
        {
          "obligation_id": "PERSIST-026-O2",
          "action": "amend",
          "criterion": "It MUST NOT copy, vendor, translate or adapt application source code, tests or scripts from Causa or any earlier rehearsal repository (indy-init-rehearsal-001 to indy-init-rehearsal-006); the same applies to indy-init-rehearsal-007 and every later rehearsal repository.",
          "rationale": "Rehearsal 7 built a persistence implementation after this list was written; the event must still be built from the requirements (ODR-V4-02)."
        },
        {
          "obligation_id": "PERSIST-052-O3",
          "action": "amend",
          "criterion": "It verifies that no F#, C#, JavaScript, TypeScript, CSS, HTML or shell file of more than 20 lines in the candidate is byte-identical, after line-ending normalization, to a file of indy-init-rehearsal-001 to indy-init-rehearsal-006, other than files generated by a published Echelon tool; the same comparison also covers indy-init-rehearsal-007, and it is run by a verifier permitted to check out those repositories, never by the implementing agent.",
          "rationale": "Extends PAT-13 to Rehearsal 7 and records who runs it (Rehearsal 7 KD-009: the implementing agent may not access prior rehearsals)."
        },
        {
          "obligation_id": "PERSIST-051-O2",
          "action": "amend",
          "criterion": "The test MUST verify that each legal transition reaches the state PERSIST-031 defines, that every illegal input fails closed with a typed fault, and that Saved is reached only from a read-back confirmation, or from the verified-load confirmation of the amended PERSIST-023-O2, and from no other input; it also verifies that a reply to a request the tab has superseded (an older load, refresh, conflict re-read or reconciliation read, or any reply whose base head or request identity no longer matches the tab's current one) is discarded without changing the state, the base head or the unsaved changes.",
          "rationale": "Closes the stale-reply defect class found by Rehearsal 7's third review (ODR-V4-03)."
        },
        {
          "obligation_id": "PERSIST-031-O22",
          "action": "amend",
          "criterion": "The action is Retry when a retry can succeed, or Reconnect when the credential was refused; Reconnect accepts a new credential for the same repository within the tab, keeps every investigation and every unsaved change in memory, re-checks the new credential's permissions, and then lets the user save again; unsaved changes are dropped only by an explicit, confirmed discard.",
          "rationale": "An expired or revoked token is a recoverable failure; the user's work must survive it (ODR-V4-04)."
        },
        {
          "obligation_id": "PERSIST-012-O2",
          "action": "amend",
          "criterion": "The application MUST offer three actions: review the differences, reapply my changes to the GitHub version, and discard my changes and load the GitHub version; when the GitHub version was deleted or fails verification, the application also states why reapply and load cannot complete and offers to export the tab's unsaved commands as a file the user saves, without writing anything to GitHub or to browser storage.",
          "rationale": "Every conflict must have a resolution that keeps the user's work without overwriting another writer (ODR-V4-05)."
        },
        {
          "obligation_id": "PERSIST-051-O3",
          "action": "amend",
          "criterion": "A compile-time negative check verifies that application code outside the persistence module cannot construct Saved, and also that it cannot construct a provider reply, a read-back result or a confirmation that the save process accepts: provider answers are decoded from the transport inside the persistence module only.",
          "rationale": "Closes the forged-reply route to a confirmation that Rehearsal 7's reviews 2 and 3 left open (ODR-V4-06)."
        },
        {
          "obligation_id": "PERSIST-023-O2",
          "action": "amend",
          "criterion": "Saved MUST be constructible only from a confirmation produced by the PERSIST-007 read-back. A load that reads the investigation at a named commit and verifies it as a reader would (PERSIST-005) also produces such a confirmation for that commit, constructed only inside the persistence module from the bytes it verified.",
          "rationale": "Reconciles PERSIST-021 with PERSIST-007 and PERSIST-023 without opening a route to Saved for unverified bytes (ODR-V4-08)."
        },
        {
          "obligation_id": "PERSIST-007-O2",
          "action": "amend",
          "criterion": "Only a confirmed save may move the investigation to Saved and advance its base head, except that a load verified at a named commit under the amended PERSIST-023-O2 shows Saved at that commit (PERSIST-021) and sets the base head to it.",
          "rationale": "Reconciles PERSIST-007 with PERSIST-021 (ODR-V4-08)."
        },
        {
          "obligation_id": "PERSIST-007-O4",
          "action": "amend",
          "criterion": "Acceptance: PAT-02 and PAT-10 verify that Saved appears only after the read-back, and PAT-12 verifies that no other transition reaches Saved, other than the verified-load confirmation of the amended PERSIST-023-O2, which PAT-12 verifies separately.",
          "rationale": "PAT-12 must check both legal entries to Saved and no third (ODR-V4-08)."
        },
        {
          "decision_id": "ODR-V4-07",
          "action": "select-topology",
          "topology": "C-role-lanes-two-ui"
        },
