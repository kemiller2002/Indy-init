{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/indy-init.environment-profile.v1.json",
  "title": "Indy Init Competition Environment Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "primaryPlatform",
    "supportedPlatforms",
    "registryBaseProfile",
    "cleanHost",
    "components",
    "contractBundle",
    "implementationBoundary"
  ],
  "properties": {
    "schema": {
      "const": "indy-init.environment-profile/v1"
    },
    "id": {
      "const": "indy-init"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pre-freeze",
        "frozen"
      ]
    },
    "primaryPlatform": {
      "type": "string",
      "minLength": 1
    },
    "supportedPlatforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "registryBaseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "cleanHost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managedByConditor",
        "external"
      ],
      "properties": {
        "managedByConditor": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "required",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "minimumVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "systemId",
          "role",
          "required",
          "purpose"
        ],
        "properties": {
          "systemId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "role": {
            "enum": [
              "bootstrap",
              "host-tool",
              "repository-lifecycle",
              "project-binding",
              "contract-bundle"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "purpose": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "contractBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceManifest",
        "lockAtFreeze"
      ],
      "properties": {
        "sourceManifest": {
          "type": "string"
        },
        "lockAtFreeze": {
          "type": "string"
        }
      }
    },
    "implementationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationImplementationIncluded",
        "rule"
      ],
      "properties": {
        "applicationImplementationIncluded": {
          "const": false
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
