<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>persistence-verification</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- The approved Causa GitHub adapter is compiled from a pinned checkout of
       kemiller2002/indy-init-rehearsal-002 (src/engine/GitHub.fs), never copied:
       dotnet build -p:CausaEngineDir=<checkout>/src/engine -->
  <Target Name="RequireCausaEngineDir" BeforeTargets="CoreCompile">
    <Error Condition="'$(CausaEngineDir)' == '' Or !Exists('$(CausaEngineDir)/GitHub.fs')" Text="Set CausaEngineDir to src/engine of indy-init-rehearsal-002 at the pinned commit." />
  </Target>
  <ItemGroup>
    <Compile Include="$(CausaEngineDir)/GitHub.fs" Link="Adapter/GitHub.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
