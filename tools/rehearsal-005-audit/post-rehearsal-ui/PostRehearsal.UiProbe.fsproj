<Project Sdk="Microsoft.NET.Sdk">
  <!-- Post-rehearsal browser probes for the Rehearsal 5 implementation audit (UI-011-O4, UI-016-O11). They drive the
       frozen candidate's own test build (obj/site-test of indy-init-rehearsal-005 at 1b9fb56, served unmodified by
       its scripts/serve.mjs) and print measurements as JSON. Post-rehearsal evidence only.
       dotnet run -c Release with arguments: site-url chromium-executable -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>r5-ui-probe</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
  </ItemGroup>
</Project>
