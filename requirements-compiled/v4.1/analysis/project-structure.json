{
  "schema": "indy-init.v41-project-structure/1",
  "description": "Project structure and file ownership for the event build, derived from the dependency direction Web/Persistence -> Application -> Domain (FSHARP-TYPE-SHAPES section 46, a reversible choice) and from the interface specifications. Each file has one primary owner. After the T14 interface freeze, only integration edits shared files and project files; every project file's Compile list is written once, complete, at T14, so no agent adds a file to a project later. Test files for bound test identities are generated from the verification plan (agent-file-ownership.json). Contract tests (one file per interface and side), state-machine tests (one file per machine, in its owner's test project) and the unit-test files named by requiredTests are generated with their owners, so every Compile list is complete at bootstrap.",
  "roles": [
    {
      "id": "domain",
      "lane": "domain",
      "description": "F# kernel: identity, commands, events, decide, evolve, replay, projection, policies, capabilities"
    },
    {
      "id": "persistence",
      "lane": "persistence",
      "description": "storage codec, wire, classification, save machine, reconciliation, session, stateful fake"
    },
    {
      "id": "ui",
      "lane": "ui",
      "description": "Limen engine, routes, projections, workspace shell, investigation views, save indicator, conflict review"
    },
    {
      "id": "ui-2",
      "lane": "ui-2",
      "description": "second UI agent (topology C): causal graph, report, history and semantic diff, administration and settings views In a topology without a ui-2 lane (A-role-lanes, B-single-lead) these files belong to ui.",
      "fallback": "ui"
    },
    {
      "id": "integration",
      "lane": "integration",
      "description": "sole writer of every shared file after T14: solution, project files, package manifests, CI, deployment, host shim, boundary script, stylesheet entry; merges qualifying pull requests; runs cross-component contract tests"
    },
    {
      "id": "coordinator",
      "lane": "coordinator",
      "description": "interface change control, requirements ledger, kickoff record and clock"
    },
    {
      "id": "reviewer",
      "lane": "reviewer",
      "description": "independent review checkpoints; writes no product file"
    }
  ],
