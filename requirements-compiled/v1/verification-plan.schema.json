{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/indy-init-verification-plan/v1",
  "title": "Indy Init verification plan (indy-init.verification-plan/1)",
  "description": "Generated by tools/requirements-compiler as requirements-compiled/v1/verification-plan.json. One entry per baseline P0 requirement: acceptance obligations with stable ids, verification method, test identity (bound or explicitly missing), evidence contract, dependencies and freshness policy. The plan identity is the SHA-256 of the canonical serialization of every member except planIdentity. Consumer contract: docs/VERIFICATION-PLAN-CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "planIdentity",
    "source",
    "scope",
    "statusVocabulary",
    "freshnessPolicies",
    "evidenceContract",
    "exclusionPolicy",
    "requirements"
  ],
  "properties": {
    "schema": { "const": "indy-init.verification-plan/1" },
    "planIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "algorithm", "digest", "covers"],
      "properties": {
        "planId": { "type": "string", "pattern": "^VP-[0-9a-f]{12}$", "description": "VP- plus the first 12 hex digits of digest." },
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" },
        "covers": { "type": "string", "description": "Which bytes the digest covers (prose, fixed text)." }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "baselineId", "baselineSha256", "approvals"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "$ref": "#/$defs/commit" },
        "baselineId": { "type": "string", "minLength": 1 },
        "baselineSha256": { "$ref": "#/$defs/sha256" },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "path", "sha256", "trustedOperators"],
          "properties": {
            "repository": { "type": "string" },
            "commit": { "$ref": "#/$defs/commit" },
            "path": { "type": "string" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "trustedOperators": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "origin", "requirements", "obligations", "boundObligations", "missingTestObligations", "excludedRequirements"],
      "properties": {
        "priority": { "const": "P0" },
        "origin": { "const": "baseline" },
        "requirements": { "type": "integer", "minimum": 0 },
        "obligations": { "type": "integer", "minimum": 0 },
        "boundObligations": { "type": "integer", "minimum": 0 },
        "missingTestObligations": { "type": "integer", "minimum": 0 },
        "excludedRequirements": { "type": "integer", "minimum": 0 }
      }
    },
    "statusVocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testIdentity", "verification"],
      "properties": {
        "testIdentity": { "type": "array", "items": { "enum": ["bound", "partial", "missing"] } },
        "verification": { "type": "array", "items": { "type": "string" } }
      }
    },
    "freshnessPolicies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "testKinds", "rule", "reusable", "reuseCondition"],
        "properties": {
          "id": { "$ref": "#/$defs/freshnessPolicyId" },
          "testKinds": { "type": "array", "items": { "$ref": "#/$defs/testKind" } },
          "rule": { "type": "string" },
          "reusable": { "type": "boolean" },
          "reuseCondition": { "type": "string" }
        }
      }
    },
    "evidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceSchema", "manifestSchema", "mustMatch", "digest", "reuse"],
      "properties": {
        "evidenceSchema": { "const": "causa.acceptance-evidence/1" },
        "manifestSchema": { "const": "causa.acceptance-evidence-manifest/1" },
        "mustMatch": { "type": "array", "items": { "type": "string" } },
        "digest": { "type": "string" },
        "reuse": { "type": "string" }
      }
    },
    "exclusionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "approvalSchema"],
      "properties": {
        "rule": { "type": "string" },
        "approvalSchema": { "const": "causa.requirements-approvals/1" }
      }
    },
    "requirements": {
      "type": "array",
      "description": "Sorted ordinally by requirement id; every baseline P0 requirement appears exactly once, excluded or not.",
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "testKind": { "enum": ["live", "deterministic", "review"] },
    "freshnessPolicyId": { "enum": ["FP-LIVE-PER-COMMIT", "FP-REVIEW-PER-COMMIT", "FP-DETERMINISTIC-INPUT-DIGEST"] },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Exact test identity as the runner reports it (never a paraphrase)." },
        "kind": { "$ref": "#/$defs/testKind" }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceObligation", "index", "kind", "text", "textSha256", "testIdentity"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VPO-[0-9a-f]{16}$",
          "description": "VPO- plus the first 16 hex digits of sha256(requirementId LF sourceObligationId LF text). Stable while the requirement, obligation id and verbatim text are unchanged."
        },
        "sourceObligation": { "type": "string", "description": "The baseline obligation id, unchanged." },
        "index": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string" },
        "text": { "type": "string", "description": "Verbatim baseline obligation text." },
        "textSha256": { "$ref": "#/$defs/sha256" },
        "testIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tests"],
          "properties": {
            "status": { "enum": ["bound", "missing"] },
            "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } }
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "priority",
        "title",
        "document",
        "sectionSha256",
        "obligations",
        "acceptance",
        "verificationMethod",
        "testIdentity",
        "evidenceContract",
        "dependencies",
        "freshness",
        "exclusion"
      ],
      "properties": {
        "requirement": { "type": "string", "description": "Baseline requirement id, unchanged." },
        "priority": { "const": "P0" },
        "title": { "type": "string" },
        "document": { "type": "string" },
        "sectionSha256": { "$ref": "#/$defs/sha256" },
        "obligations": { "type": "array", "items": { "$ref": "#/$defs/obligation" } },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criteria", "linkedSections"],
          "properties": {
            "criteria": { "type": "array", "items": { "type": "string" } },
            "linkedSections": { "type": "array", "items": { "type": "string" } }
          }
        },
        "verificationMethod": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gates", "rules"],
          "properties": {
            "gates": { "type": "array", "items": { "type": "string" } },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "gate", "owner", "method", "tooling"],
                "properties": {
                  "id": { "type": "string" },
                  "gate": { "type": "string" },
                  "owner": { "type": "string" },
                  "method": { "type": "string" },
                  "tooling": { "type": "string" }
                }
              }
            }
          }
        },
        "testIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "boundObligations", "missingObligations"],
          "properties": {
            "status": { "enum": ["bound", "partial", "missing"] },
            "boundObligations": { "type": "integer", "minimum": 0 },
            "missingObligations": { "type": "integer", "minimum": 0 }
          }
        },
        "evidenceContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subjectType", "subjectId", "requiredEvidence"],
          "properties": {
            "subjectType": { "const": "requirement" },
            "subjectId": { "type": "string" },
            "requiredEvidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirements", "contracts"],
          "properties": {
            "requirements": { "type": "array", "items": { "type": "string" } },
            "contracts": { "type": "array", "items": { "type": "string" } }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "boundTo", "invalidatedBy"],
          "properties": {
            "policy": { "$ref": "#/$defs/freshnessPolicyId" },
            "boundTo": { "type": "array", "items": { "type": "string" } },
            "invalidatedBy": { "type": "array", "items": { "type": "string" } }
          }
        },
        "exclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approval"],
          "properties": {
            "status": { "enum": ["in-scope", "excluded"] },
            "approval": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
