{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/indy-init-verification-plan/v1/revision-3",
  "title": "Indy Init verification plan (indy-init.verification-plan/1, revision 2: executable acceptance contracts)",
  "description": "Generated by tools/requirements-compiler as requirements-compiled/v3/verification-plan.json. One entry per baseline P0 requirement: acceptance obligations with stable ids, verification method, test identity (bound or explicitly missing), evidence contract, dependencies and freshness policy; revision 2 adds, additively, each obligation's value tokens and acceptance contract (required evidence categories derived from the embedded evidence-categories table, test identity bound or unbound, freshness requirement, verification status and missing coverage), the embedded table, and scope and vocabulary members. Every revision-1 member keeps its name, type and meaning; a consumer that ignores unknown members (Ordo VerificationPlanWire) reads revision 2 unchanged. The revision-1 schema document (requirements-compiled/v1) is closed (additionalProperties false) and therefore rejects revision-2 plans. The plan identity is the SHA-256 of the canonical serialization of every member except planIdentity. Revision 2 also carries, additively, each category's evidence class and producer (application-test, reviewer, process, owner) and the process-record and owner-decision categories. Consumer contract: docs/VERIFICATION-PLAN-CONTRACT.md. Revision 3 adds, additively and only when the curation uses them, the top-level scopeDecisions and, per obligation and in its acceptance contract, amendment (an operator-approved acceptance criterion beside the verbatim text) and derivation (clauses of an obligation that restates others).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "planIdentity",
    "source",
    "scope",
    "statusVocabulary",
    "freshnessPolicies",
    "evidenceContract",
    "exclusionPolicy",
    "evidenceCategories",
    "requirements"
  ],
  "properties": {
    "schema": {
      "const": "indy-init.verification-plan/1"
    },
    "planIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "algorithm",
        "digest",
        "covers"
      ],
      "properties": {
        "planId": {
          "type": "string",
          "pattern": "^VP-[0-9a-f]{12}$",
          "description": "VP- plus the first 12 hex digits of digest."
        },
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "covers": {
          "type": "string",
          "description": "Which bytes the digest covers (prose, fixed text)."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "baselineId",
        "baselineSha256",
        "approvals"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "baselineId": {
          "type": "string",
          "minLength": 1
        },
        "baselineSha256": {
          "$ref": "#/$defs/sha256"
        },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "path",
            "sha256",
            "trustedOperators"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "commit": {
              "$ref": "#/$defs/commit"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "trustedOperators": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "origin",
        "requirements",
        "obligations",
        "boundObligations",
        "missingTestObligations",
        "excludedRequirements",
        "verifiedObligations",
        "unverifiedObligations",
        "unclassifiedObligations",
        "excludedObligations",
        "obligationsWithEveryCategoryBound",
        "obligationsByCategory"
      ],
      "properties": {
        "priority": {
          "const": "P0"
        },
        "origin": {
          "const": "baseline"
        },
        "requirements": {
          "type": "integer",
          "minimum": 0
        },
        "obligations": {
          "type": "integer",
          "minimum": 0
        },
        "boundObligations": {
          "type": "integer",
          "minimum": 0
        },
        "missingTestObligations": {
          "type": "integer",
          "minimum": 0
        },
        "excludedRequirements": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedObligations": {
          "const": 0,
          "description": "The plan never reports an obligation verified; only an assessment of evidence can."
        },
        "unverifiedObligations": {
          "type": "integer",
          "minimum": 0
        },
        "unclassifiedObligations": {
          "type": "integer",
          "minimum": 0
        },
        "excludedObligations": {
          "type": "integer",
          "minimum": 0
        },
        "obligationsWithEveryCategoryBound": {
          "type": "integer",
          "minimum": 0
        },
        "obligationsByCategory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "integration",
            "browser",
            "live-provider",
            "security",
            "accessibility",
            "independent-acceptance",
            "process-record",
            "owner-decision"
          ],
          "properties": {
            "unit": {
              "type": "integer",
              "minimum": 0
            },
            "integration": {
              "type": "integer",
              "minimum": 0
            },
            "browser": {
              "type": "integer",
              "minimum": 0
            },
            "live-provider": {
              "type": "integer",
              "minimum": 0
            },
            "security": {
              "type": "integer",
              "minimum": 0
            },
            "accessibility": {
              "type": "integer",
              "minimum": 0
            },
            "independent-acceptance": {
              "type": "integer",
              "minimum": 0
            },
            "process-record": {
              "type": "integer",
              "minimum": 0
            },
            "owner-decision": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "statusVocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testIdentity",
        "verification",
        "contractTestIdentity",
        "obligationVerification",
        "missingCoverage",
        "evidenceCategories",
        "diagnostics"
      ],
      "properties": {
        "testIdentity": {
          "type": "array",
          "items": {
            "enum": [
              "bound",
              "partial",
              "missing"
            ]
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contractTestIdentity": {
          "type": "array",
          "items": {
            "enum": [
              "bound",
              "unbound"
            ]
          }
        },
        "obligationVerification": {
          "type": "array",
          "items": {
            "enum": [
              "verified",
              "unverified",
              "unclassified",
              "excluded"
            ]
          }
        },
        "missingCoverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceCategories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceCategory"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "freshnessPolicies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "testKinds",
          "rule",
          "reusable",
          "reuseCondition"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/freshnessPolicyId"
          },
          "testKinds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/testKind"
            }
          },
          "rule": {
            "type": "string"
          },
          "reusable": {
            "type": "boolean"
          },
          "reuseCondition": {
            "type": "string"
          }
        }
      }
    },
    "evidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceSchema",
        "manifestSchema",
        "mustMatch",
        "digest",
        "reuse",
        "obligationEvidence"
      ],
      "properties": {
        "evidenceSchema": {
          "const": "causa.acceptance-evidence/1"
        },
        "manifestSchema": {
          "const": "causa.acceptance-evidence-manifest/1"
        },
        "mustMatch": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest": {
          "type": "string"
        },
        "reuse": {
          "type": "string"
        },
        "obligationEvidence": {
          "type": "string"
        }
      }
    },
    "exclusionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "approvalSchema"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "approvalSchema": {
          "const": "causa.requirements-approvals/1"
        }
      }
    },
    "requirements": {
      "type": "array",
      "description": "Sorted ordinally by requirement id; every baseline P0 requirement appears exactly once, excluded or not.",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "evidenceCategories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "table",
        "categories",
        "rules",
        "rule"
      ],
      "description": "The declared category table, embedded so a checker can re-derive every obligation's categories from the plan alone.",
      "properties": {
        "schema": {
          "const": "indy-init.evidence-categories/1"
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "definition",
              "testKinds",
              "freshnessPolicy",
              "evidenceClass",
              "producer"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/evidenceCategory"
              },
              "definition": {
                "type": "string"
              },
              "testKinds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/testKind"
                }
              },
              "freshnessPolicy": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/freshnessPolicyId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidenceClass": {
                "$ref": "#/$defs/evidenceClass"
              },
              "producer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "category",
              "when",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "category": {
                "$ref": "#/$defs/evidenceCategory"
              },
              "source": {
                "type": "string"
              },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "gates": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "requirements": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "obligationKinds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "obligations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "freshnessPolicies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "titlePattern": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "scopeDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amendmentRule",
        "derivationRule",
        "amendedObligations",
        "derivedObligations",
        "diagnostics",
        "missingCoverage"
      ],
      "properties": {
        "amendmentRule": {
          "type": "string"
        },
        "derivationRule": {
          "type": "string"
        },
        "amendedObligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derivedObligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingCoverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "testKind": {
      "enum": [
        "live",
        "deterministic",
        "review",
        "process",
        "owner"
      ]
    },
    "freshnessPolicyId": {
      "enum": [
        "FP-LIVE-PER-COMMIT",
        "FP-REVIEW-PER-COMMIT",
        "FP-PROCESS-THIS-RUN",
        "FP-DETERMINISTIC-INPUT-DIGEST"
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Exact test identity as the runner reports it (never a paraphrase)."
        },
        "kind": {
          "$ref": "#/$defs/testKind"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceObligation",
        "index",
        "kind",
        "text",
        "textSha256",
        "testIdentity",
        "tokens",
        "acceptanceContract"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VPO-[0-9a-f]{16}$",
          "description": "VPO- plus the first 16 hex digits of sha256(requirementId LF sourceObligationId LF text). Stable while the requirement, obligation id and verbatim text are unchanged."
        },
        "sourceObligation": {
          "type": "string",
          "description": "The baseline obligation id, unchanged."
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Verbatim baseline obligation text."
        },
        "textSha256": {
          "$ref": "#/$defs/sha256"
        },
        "testIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "tests"
          ],
          "properties": {
            "status": {
              "enum": [
                "bound",
                "missing"
              ]
            },
            "tests": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/test"
              }
            }
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The baseline obligation's value tokens, verbatim and in order (empty when it has none)."
        },
        "acceptanceContract": {
          "$ref": "#/$defs/acceptanceContract"
        },
        "amendment": {
          "$ref": "#/$defs/amendment"
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "priority",
        "title",
        "document",
        "sectionSha256",
        "obligations",
        "acceptance",
        "verificationMethod",
        "testIdentity",
        "evidenceContract",
        "dependencies",
        "freshness",
        "exclusion"
      ],
      "properties": {
        "requirement": {
          "type": "string",
          "description": "Baseline requirement id, unchanged."
        },
        "priority": {
          "const": "P0"
        },
        "title": {
          "type": "string"
        },
        "document": {
          "type": "string"
        },
        "sectionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criteria",
            "linkedSections"
          ],
          "properties": {
            "criteria": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "linkedSections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "verificationMethod": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gates",
            "rules"
          ],
          "properties": {
            "gates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "gate",
                  "owner",
                  "method",
                  "tooling"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "gate": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "method": {
                    "type": "string"
                  },
                  "tooling": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "testIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "boundObligations",
            "missingObligations"
          ],
          "properties": {
            "status": {
              "enum": [
                "bound",
                "partial",
                "missing"
              ]
            },
            "boundObligations": {
              "type": "integer",
              "minimum": 0
            },
            "missingObligations": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidenceContract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subjectType",
            "subjectId",
            "requiredEvidence"
          ],
          "properties": {
            "subjectType": {
              "const": "requirement"
            },
            "subjectId": {
              "type": "string"
            },
            "requiredEvidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirements",
            "contracts"
          ],
          "properties": {
            "requirements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contracts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "boundTo",
            "invalidatedBy"
          ],
          "properties": {
            "policy": {
              "$ref": "#/$defs/freshnessPolicyId"
            },
            "boundTo": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "invalidatedBy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "exclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "approval"
          ],
          "properties": {
            "status": {
              "enum": [
                "in-scope",
                "excluded"
              ]
            },
            "approval": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "evidenceCategory": {
      "enum": [
        "unit",
        "integration",
        "browser",
        "live-provider",
        "security",
        "accessibility",
        "independent-acceptance",
        "process-record",
        "owner-decision"
      ]
    },
    "contractTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "categories"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/testKind"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceCategory"
          }
        }
      }
    },
    "acceptanceContract": {
      "type": "object",
      "additionalProperties": false,
      "description": "Derived only from the plan entry, the obligation, its bound tests and the embedded category table; a checker re-derives it and rejects any difference (CONTRACT-INCONSISTENT).",
      "required": [
        "requirement",
        "obligation",
        "obligationId",
        "priority",
        "verificationMethod",
        "requiredEvidenceCategories",
        "categoryDerivation",
        "evidenceProducers",
        "testIdentity",
        "dependencies",
        "freshness",
        "verificationStatus",
        "missingCoverage"
      ],
      "properties": {
        "requirement": {
          "type": "string"
        },
        "obligation": {
          "type": "string"
        },
        "obligationId": {
          "type": "string",
          "pattern": "^VPO-[0-9a-f]{16}$"
        },
        "priority": {
          "const": "P0"
        },
        "verificationMethod": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gates",
            "rules"
          ],
          "properties": {
            "gates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "requiredEvidenceCategories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceCategory"
          },
          "uniqueItems": true
        },
        "categoryDerivation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "rules"
            ],
            "properties": {
              "category": {
                "$ref": "#/$defs/evidenceCategory"
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "evidenceProducers": {
          "description": "For each required category: its evidence class and the producer expected to create the evidence. Process and owner categories are proven by Praxis records through requirements-compiler verify-process, never by an application test.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "evidenceClass",
              "producer"
            ],
            "properties": {
              "category": {
                "$ref": "#/$defs/evidenceCategory"
              },
              "evidenceClass": {
                "$ref": "#/$defs/evidenceClass"
              },
              "producer": {
                "type": "string"
              }
            }
          }
        },
        "testIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "tests"
          ],
          "properties": {
            "status": {
              "enum": [
                "bound",
                "unbound"
              ]
            },
            "tests": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contractTest"
              }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirements",
            "contracts"
          ],
          "properties": {
            "requirements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contracts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "requirementPolicy",
            "categoryPolicies"
          ],
          "properties": {
            "policy": {
              "$ref": "#/$defs/freshnessPolicyId"
            },
            "requirementPolicy": {
              "$ref": "#/$defs/freshnessPolicyId"
            },
            "categoryPolicies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "category",
                  "policy"
                ],
                "properties": {
                  "category": {
                    "$ref": "#/$defs/evidenceCategory"
                  },
                  "policy": {
                    "$ref": "#/$defs/freshnessPolicyId"
                  }
                }
              }
            }
          }
        },
        "verificationStatus": {
          "enum": [
            "unverified",
            "unclassified",
            "excluded"
          ],
          "description": "Never 'verified' in the plan."
        },
        "missingCoverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "reason",
              "detail"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "unclassified",
                  "no-bound-test",
                  "no-evidence"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "amendment": {
          "$ref": "#/$defs/amendment"
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        }
      }
    },
    "evidenceClass": {
      "enum": [
        "application-test",
        "reviewer",
        "process",
        "owner"
      ]
    },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval",
        "decision",
        "criterion",
        "rationale"
      ],
      "properties": {
        "approval": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "connectives",
        "clauses"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "connectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clause",
              "residual",
              "direct",
              "constituents"
            ],
            "properties": {
              "clause": {
                "type": "string",
                "minLength": 1
              },
              "residual": {
                "type": "boolean"
              },
              "direct": {
                "type": "boolean"
              },
              "constituents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "obligation",
                    "obligationId"
                  ],
                  "properties": {
                    "obligation": {
                      "type": "string"
                    },
                    "obligationId": {
                      "type": "string",
                      "pattern": "^VPO-[0-9a-f]{16}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
