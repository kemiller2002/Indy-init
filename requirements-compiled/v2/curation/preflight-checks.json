    {
      "id": "PRE-TOOL-03",
      "category": "toolchain",
      "type": "manual",
      "params": {
        "record": "bootstrap commit in the rehearsal repository produced by Conditor on the kickoff set without the SD-1 hand workaround, first green CI (R4 P3, P5)"
      },
      "title": "Bootstrap without the SD-1 workaround reaches first green CI",
      "tasks": [
