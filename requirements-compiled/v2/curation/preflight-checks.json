{
  "schema": "indy-init.rc-preflight-checks/1",
  "description": "Rehearsal 4 preflight (untimed; ends at the first green bootstrap CI, R4 P5). Each check has an executable type run by `requirements-compiler preflight`, which writes evidence; nothing passes without being executed. Types: package-state (evaluated from the compiled package), baseline-pinned, sdk-pinned, secret-scan, git-ref-contains, registry-set-contains, env-present, github-auth-contract, manual (an owner or organizer record; never passes automatically).",
  "checks": [
    {
      "id": "PRE-DEC-01",
      "category": "owner-decisions",
      "type": "package-state",
      "params": {
        "condition": "no-unresolved-decisions"
      },
      "title": "Every decision the run depends on is decided by the owner",
      "tasks": [
        "T00"
      ],
      "refs": [
        "DEC-006",
        "DEC-022",
        "DEC-023",
        "DEC-024",
        "DEC-025"
      ]
    },
    {
      "id": "PRE-DEC-02",
      "category": "owner-decisions",
      "type": "package-state",
      "params": {
        "condition": "no-open-critical-findings"
      },
      "title": "No critical material finding is unresolved",
      "tasks": [
        "T00"
      ],
      "refs": [
        "F-001",
        "F-003",
        "F-004",
        "F-005",
        "F-008",
        "F-009"
      ]
    },
    {
      "id": "PRE-REQ-01",
      "category": "requirements-baseline",
      "type": "baseline-pinned",
      "params": {
        "baseline": "requirements/causa-requirements-baseline.json"
      },
      "title": "Committed baseline is pinned at the source commit and equals the generator's output there",
      "tasks": [
        "T01"
      ],
      "refs": [
        "F-003",
        "AR-001"
      ]
    },
    {
      "id": "PRE-REQ-02",
      "category": "requirements-preservation",
      "type": "package-state",
      "params": {
        "condition": "compilation-pass"
      },
      "title": "Compiled package passes every critical check (V01-V13, V15-V16)",
      "tasks": [
        "T07"
      ],
      "refs": [
        "AR-002"
      ]
    },
    {
      "id": "PRE-REQ-03",
      "category": "requirements-preservation",
      "type": "git-ref-contains",
      "params": {
        "repo": "praxis",
        "ref": "latest-tag:v",
        "path": "src/Praxis.Cli",
        "pattern": "preservation"
      },
      "title": "A released Praxis carries `requirements preservation verify` (RDP-004 without a VER-005 exception)",
      "tasks": [
        "T02",
        "T08"
      ],
      "refs": [
        "F-004",
        "CT-013"
      ]
    },
    {
      "id": "PRE-REQ-04",
      "category": "requirements-preservation",
      "type": "manual",
      "params": {
        "record": "praxis requirements preservation verify exit 0, evidence committed in the rehearsal repository (RDP-004)"
      },
      "title": "Preservation gate PASS on the derived package, disposition and operator approvals",
      "tasks": [
        "T08",
        "T09"
      ],
      "refs": [
        "AR-004"
      ]
    },
    {
      "id": "PRE-DEP-01",
      "category": "dependency-release",
      "type": "registry-set-contains",
      "params": {
        "repo": "echelon-registry",
        "set": "echelon-current",
        "systems": "percepta-semantic,dokimos,praxis,limen,forma,folio,ordo,aegis",
        "status": "approved"
