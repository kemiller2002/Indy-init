      "category": "verification-planning",
      "type": "package-state",
      "params": {
        "condition": "manifests-valid"
      },
      "title": "Preflight and timed-execution manifests are complete and consistent (V16)",
      "tasks": [
        "T07"
      ],
      "refs": []
